[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://character_creation.gd" id="1_charcreate"]

[node name="CharacterCreation" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_charcreate")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.08, 0.08, 0.1, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 24

[node name="Root" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Margin/Root"]
layout_mode = 2
text = "CREATE YOUR CHARACTER"

[node name="NameRow" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="NameLabel" type="Label" parent="Margin/Root/NameRow"]
layout_mode = 2
text = "Name:"

[node name="NameEdit" type="LineEdit" parent="Margin/Root/NameRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 0)
layout_mode = 2
placeholder_text = "Enter a name"

[node name="Columns" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 40

[node name="AttributesPanel" type="VBoxContainer" parent="Margin/Root/Columns"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="AttributesHeader" type="Label" parent="Margin/Root/Columns/AttributesPanel"]
unique_name_in_owner = true
layout_mode = 2
text = "ATTRIBUTES"

[node name="AttributesList" type="VBoxContainer" parent="Margin/Root/Columns/AttributesPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="SkillsPanel" type="VBoxContainer" parent="Margin/Root/Columns"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="SkillsHeader" type="Label" parent="Margin/Root/Columns/SkillsPanel"]
unique_name_in_owner = true
layout_mode = 2
text = "SKILLS"

[node name="SkillsScroll" type="ScrollContainer" parent="Margin/Root/Columns/SkillsPanel"]
custom_minimum_size = Vector2(0, 420)
layout_mode = 2
size_flags_vertical = 3

[node name="SkillsList" type="VBoxContainer" parent="Margin/Root/Columns/SkillsPanel/SkillsScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 2

[node name="ButtonRow" type="HBoxContainer" parent="Margin/Root"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 12

[node name="BackButton" type="Button" parent="Margin/Root/ButtonRow"]
custom_minimum_size = Vector2(120, 36)
layout_mode = 2
text = "BACK"

[node name="ConfirmButton" type="Button" parent="Margin/Root/ButtonRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(160, 36)
layout_mode = 2
disabled = true
text = "BEGIN ADVENTURE"

[connection signal="text_changed" from="Margin/Root/NameRow/NameEdit" to="." method="_on_name_text_changed"]
[connection signal="pressed" from="Margin/Root/ButtonRow/BackButton" to="." method="_on_back_pressed"]
[connection signal="pressed" from="Margin/Root/ButtonRow/ConfirmButton" to="." method="_on_confirm_pressed"]
