# Godot 4+ specific ignores
.godot/
/android/

# GDExtension native build — godot-cpp is a cloned+compiled dependency
# (~65MB static lib alone), not project source; re-fetch via
# `git clone --branch 4.4 https://github.com/godotengine/godot-cpp.git`
# into gdextension/ and rebuild with SCons rather than versioning it.
gdextension/godot-cpp/
gdextension/src/*.o
gdextension/.sconsign*.dblite
gdextension/.sconf_temp/

# Windows leftovers from replacing a DLL that a running Godot editor holds
# open: the rebuild cannot overwrite libnavigationgrid.dll, so Windows drops
# a ~-prefixed copy beside it. Committed by accident twice (4fa6a53,
# 71202de) — 1.2MB of build junk each time.
bin/win64/~*
*.TMP

# SFZ sample libraries (22 GB, several not redistributable); shipped beside the exe, never in git
/samples/

# sfzplayer debug symbols (13 MB per build) and the ~-prefixed copies Windows
# leaves when a rebuild replaces a DLL the editor holds open.
addons/sfzplayer/bin/*.pdb
addons/sfzplayer/bin/~*
