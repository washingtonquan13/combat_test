; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Combat Test"
run/main_scene="uid://d1qy6jfw10nnh"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SelectionManager="*res://selection_manager.gd"
CombatManager="*res://combat_manager.gd"
CombatAi="*res://combat_ai.gd"
AbilityManager="*res://systems/ability_system/ability_manager.gd"
SurfaceManager="*res://surface_manager.gd"
SystemLog="*res://system_log.gd"
InteractionMenu="*res://interaction_menu.gd"
CameraDirector="*res://camera_director.gd"
DialogueManager="*res://systems/dialogue_system/dialogue_manager.gd"
StashManager="*res://stash_manager.gd"
FlagManager="*res://flag_manager.gd"
DemonRoster="*res://systems/demon_system/demon_roster.gd"
NegotiationManager="*res://systems/negotiation_system/negotiation_manager.gd"
DebugSpawner="*res://debug_spawner.gd"
MusicManager="*res://systems/music_system/music_manager.gd"
CurrencyManager="*res://systems/currency_system/currency_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/animation_sequence_tools/plugin.cfg")

