    | f3:0.5! c4:0.5 a4:0.5 c4:0.5 b4:0.5 c4:0.5 a4:0.5 c4:0.5 |
    | b3:0.5! f#4:0.5 e5:0.5 f#4:0.5 b3:0.5! f#4:0.5 d#5:0.5 f#4:0.5 |
    | b3:0.25! a4:0.25 d#5:0.25 b3:0.25! a4:0.25 d#5:0.25 b4:0.25! d#5:0.25 c4:0.25! c5:0.25 c#4:0.25! c#5:0.25 d4:0.25! d5:0.25 d#4:0.25! d#5:0.25! |

  lead dyn:mp..f feel:tight vib:warm
    // C - the climb's D# rises to E, but the chord under it is C
    | e5:1.5_ g5:1.5 a5:1~ |
    // G/B, then the same line a half step down as the chord goes minor
    | b5:3_ a5:0.5 g5:0.5 |
    | bb5:3_< a5:0.5 g5:0.5 |
    // Am - up to the top of the section
    | a5:2_ c6:1 e6:1 |
    // Fmaj7 - E held over F, then B, the tritone, falling to A
    | e6:3_ d6:0.5 c6:0.5 |
    | b5:2_ a5:2_ |
    // B7sus4 to B7 - E falls to D#, the leading tone
    | e5:2_ d#5:2_ |
    | f#5:2_< c5:0.5! c#5:0.5! d5:0.5! d#5:0.5! |

// The second pass. Each section is the first one again, note for note;
// only the drive and the final reprise change, as "The hook" above says.
section riff2 from:riff
  // A second verse is the first one with more in it, never with less, and
  // never as much as the chorus. The riff, the guitar and the bass's motif
  // stay note for note - they are what the ear holds on to - and everything
  // around them moves.
  //
  // The pad stays, quietly. The reprise ends with the whole band on a climb
  // into E, and the first riff began from silence; the second begins from a
  // full band, and a pad under it at pp is what keeps that from sounding
  // like the track restarting.
  pad dyn:pp..p
    | [g3 b3 e4]:4 | [g3 c4 e4]:4 | [f#3 c4 d4]:4 | [f#3 b3 d#4]:4^ |
    | [g3 b3 e4]:4 | [g3 c4 e4]:4 | [a3 c4 e4]:4 | [a3 b3 d#4]:4^ |

  bass dyn:mf..f feel:tight
    | e2:0.75! e2:0.25+ e3:0.5' e2:0.5 g2:0.5 a2:0.5 g2:0.5 d2:0.5/ |
    | c2:0.75! c2:0.25+ c3:0.5' c2:0.5 e2:0.5 g2:0.5 e2:0.5 c#2:0.5 |
    | d2:0.75! d2:0.25+ d3:0.5' d2:0.5 f#2:0.5 a2:0.5 f#2:0.5 c2:0.5/ |
    // B7 - the one new bar: up the chord from its fifth, F# A B, to D#, then
    // back down B F# into E. The same notes as before in a new order, so it
    // is a variation and not a different line.
    | b1:0.75! b1:0.25+ b2:0.5' f#2:0.25' a2:0.25 b2:0.5 d#3:0.5! b2:0.5 f#2:0.5/ |
    | e2:0.75! e2:0.25+ e3:0.5' e2:0.5 g2:0.5 a2:0.5 g2:0.5 d2:0.5 |
    | c2:0.75! c2:0.25+ c3:0.5' c2:0.5 e2:0.5 g2:0.5 b2:0.5 bb2:0.5/ |
    | a2:0.75! a2:0.25+ a3:0.5' a2:0.5 c3:0.5 e3:0.5< d3:0.5 c3:0.5 |
    | b1:0.5! b1:0.25+ b1:0.25+ b2:0.5' b1:0.5 c2:0.5 c#2:0.5 d2:0.5 d#2:0.5! |

  // The kit is where a second verse is most easily heard. Hats as before for
  // the first phrase, with an open hat into bars 3 and 4; then half open for
  // the second phrase, which is the same pattern with more wash - the energy
  // goes up without the part changing.
  perc.right dyn:mf..f feel:tight
    | crash_big:0.5! hat:0.5. hat:0.5 hat:0.5. hat:0.5 hat:0.5. hat:0.5 hat:0.5. |
    | hat:0.5! hat:0.5. hat:0.5 hat:0.5. hat:0.5 hat:0.5. hat:0.5 hat_open:0.5 |
    | hat:0.5! hat:0.5. hat:0.5 hat:0.5. hat:0.5 hat:0.5. hat:0.5 hat_open:0.5 |
    | hat:0.5! hat:0.5. hat:0.5 hat:0.5. hat:0.5 hat:0.5. r:1 |
    | crash:0.5! hat_loose:0.5. hat_loose:0.5 hat_loose:0.5. hat_loose:0.5 hat_loose:0.5. hat_loose:0.5 hat_loose:0.5. |
    | hat_loose:0.5! hat_loose:0.5. hat_loose:0.5 hat_loose:0.5. hat_loose:0.5 hat_loose:0.5. hat_loose:0.5 hat_open:0.5 |
    | hat_loose:0.5! hat_loose:0.5. hat_loose:0.5 hat_loose:0.5. hat_loose:0.5 hat_loose:0.5. hat_loose:0.5 hat_open:0.5 |
    | hat_loose:0.5! hat_loose:0.5. hat_loose:0.5 hat_loose:0.5. r:2 |
  // Ghost notes between the backbeats: the same two accents on 2 and 4,
  // with the hand filling in quietly around them. The bar-4 fill now runs
  // down the toms in pairs instead of once each.
  perc.left dyn:mf..f feel:tight
    | r:0.75 snare:0.25. snare:0.75! snare:0.25. r:0.5 snare:0.25. snare:0.25. snare:1! |
    | r:0.75 snare:0.25. snare:0.75! snare:0.25. r:0.5 snare:0.25. snare:0.25. snare:1! |
    | r:0.75 snare:0.25. snare:0.75! snare:0.25. r:0.5 snare:0.25. snare:0.25. snare:1! |
    | r:0.75 snare:0.25. snare:1! r:0.5 tom_high:0.25 tom_high:0.25 tom_mid:0.25 tom_mid:0.25 tom_floor:0.25 tom_floor:0.25 |
    | r:0.75 snare:0.25. snare:0.75! snare:0.25. r:0.5 snare:0.25. snare:0.25. snare:1! |
    | r:0.75 snare:0.25. snare:0.75! snare:0.25. r:0.5 snare:0.25. snare:0.25. snare:1! |
    | r:0.75 snare:0.25. snare:0.75! snare:0.25. r:0.5 snare:0.25. snare:0.25. snare:1! |
    | r:0.5 snare:0.25. snare:0.25. snare:1! snare:0.25. snare:0.25. snare:0.25 snare:0.25 snare:0.25 snare:0.25 snare:0.25! snare:0.25! |
  // And in the second phrase a double-kick flick after the "and" of 2, a
  // taste of the gallop the drive makes constant.
  perc.feet dyn:mf..f feel:tight
    | kick:1.5! kick:0.5 kick:2 |
    | kick:1.5! kick:0.5 kick:1.5 kick:0.5 |
    | kick:1.5! kick:0.5 kick:2 |
    | kick:1.5! kick:0.5 kick:2 |
    | kick:1.5! kick:0.25 kick:0.25 kick:2 |
    | kick:1.5! kick:0.25 kick:0.25 kick:1.5 kick:0.5 |
    | kick:1.5! kick:0.25 kick:0.25 kick:2 |
    | kick:1.5! kick:0.5 kick:0.5 kick:0.5 kick:0.5 kick:0.5 |

section answer2 from:answer
  // The answer's first phrase is left alone; its second is where the second
  // pass starts to lean toward the drive.
  //
  // The guitar's held chords get two stabs at the end of bars 5-7, the last
  // one accented on the "and" of 4, pulling each bar into the next.
  guitar dyn:mf feel:tight pocket:lay
    | [e2 b2 e3]:1.5! [e2 b2 e3]:0.5' [e2 b2 e3]:2_ |
    | [c3 g3 c4]:1.5! [c3 g3 c4]:0.5' [c3 g3 c4]:2_ |
    | [d3 a3 d4]:1.5! [d3 a3 d4]:0.5' [d3 a3 d4]:2_ |
    | [b2 f#3 b3]:1.5! [b2 f#3 b3]:0.5' [b2 f#3 b3]:2_ |
    | [e2 b2 e3]:1.5! [e2 b2 e3]:0.5' [e2 b2 e3]:1_ [e2 b2 e3]:0.5' [e2 b2 e3]:0.5! |
    | [c3 g3 c4]:1.5! [c3 g3 c4]:0.5' [c3 g3 c4]:1_ [c3 g3 c4]:0.5' [c3 g3 c4]:0.5! |
    | [a2 e3 a3]:1.5! [a2 e3 a3]:0.5' [a2 e3 a3]:1_ [a2 e3 a3]:0.5' [a2 e3 a3]:0.5! |
    | [b2 f#3 b3]:2! [c3 g3 c4]:0.5! [c#3 g#3 c#4]:0.5! [d3 a3 d4]:0.5! [d#3 a#3 d#4]:0.5! |

  // The ride moves its bell onto every beat for the second phrase - the
  // quarter-note pulse a band plays when it is about to go up a gear.
  perc.right dyn:mf..f feel:tight pocket:lay
    | crash_big:0.5! ride:0.5. ride:0.5 ride:0.5. ride_bell:0.5 ride:0.5. ride:0.5 ride:0.5. |
    | ride:0.5! ride:0.5. ride:0.5 ride:0.5. ride_bell:0.5 ride:0.5. ride:0.5 ride:0.5. |
    | ride:0.5! ride:0.5. ride:0.5 ride:0.5. ride_bell:0.5 ride:0.5. ride:0.5 ride:0.5. |
    | ride:0.5! ride:0.5. ride:0.5 ride:0.5. ride_bell:0.5 ride:0.5. r:1 |
    | crash_mid:0.5! ride:0.5. ride_bell:0.5 ride:0.5. ride_bell:0.5 ride:0.5. ride_bell:0.5 ride:0.5. |
    | ride_bell:0.5! ride:0.5. ride_bell:0.5 ride:0.5. ride_bell:0.5 ride:0.5. ride_bell:0.5 ride:0.5. |
    | ride_bell:0.5! ride:0.5. ride_bell:0.5 ride:0.5. ride_bell:0.5 ride:0.5. ride_bell:0.5 ride:0.5. |
    | ride_bell:0.5! ride:0.5. ride_bell:0.5 r:2.5 |
  perc.left dyn:mf..f feel:tight pocket:lay
    | r:1.75 snare:0.25. snare:1.5! snare:0.25. snare:0.25. |
    | r:1.75 snare:0.25. snare:1.5! snare:0.25. snare:0.25. |
    | r:1.75 snare:0.25. snare:1.5! snare:0.25. snare:0.25. |
    // A new fill: a snare pair, then one stroke on each tom, high to floor.
    | r:1.75 snare:0.25. snare:0.5! snare:0.25 snare:0.25 tom_high:0.25 tom_mid:0.25 tom_low:0.25 tom_floor:0.25 |
    | r:1.75 snare:0.25. snare:1.5! snare:0.25. snare:0.25. |
    | r:1.75 snare:0.25. snare:1.5! snare:0.25. snare:0.25. |
    | r:1.75 snare:0.25. snare:1.5! snare:0.25. snare:0.25. |
    | r:1 snare:0.5! tom_floor:0.25 tom_high:0.25 tom_floor:0.25 tom_high:0.25 tom_floor:0.25 tom_high:0.25 tom_floor:0.25 tom_high:0.25 snare:0.5! |
  perc.feet dyn:mf..f feel:tight pocket:lay
    | kick:1! hat_pedal:0.5. kick:1.5 kick:1 |
    | kick:1! hat_pedal:0.5. kick:1.5 kick:1 |
    | kick:1! hat_pedal:0.5. kick:1.5 kick:1 |
    | kick:1! hat_pedal:0.5. kick:1.5 kick:1 |
    | kick:1! hat_pedal:0.5. kick:1 kick:0.25 kick:0.25 kick:1 |
    | kick:1! hat_pedal:0.5. kick:1 kick:0.25 kick:0.25 kick:1 |
    | kick:1! hat_pedal:0.5. kick:1 kick:0.25 kick:0.25 kick:1 |
    | kick:1! hat_pedal:0.5. r:2 kick:0.5! |

  // And Glass comes in early. The drive's arpeggio is sixteenths; this is
  // the same idea in eighths, an octave higher and quiet, over the second
  // phrase only - so when the drive arrives its arpeggio is one already
  // playing, doubling its speed, rather than a new part. Root, fifth or
  // octave, third: chord tones only. In the last bar it joins the climb
  // with everyone else.
  keys dyn:pp..p feel:tight pocket:lay
    | r:4 | r:4 | r:4 | r:4 |
    | e5:0.5! b5:0.5 g5:0.5 b5:0.5 e5:0.5! b5:0.5 g5:0.5 b5:0.5 |
    | e5:0.5! c6:0.5 g5:0.5 c6:0.5 e5:0.5! c6:0.5 g5:0.5 c6:0.5 |
    | e5:0.5! c6:0.5 a5:0.5 c6:0.5 e5:0.5! c6:0.5 a5:0.5 c6:0.5 |
    | d#5:0.5! b5:0.5 f#5:0.5 b5:0.5 c6:0.5! c#6:0.5! d6:0.5! d#6:0.5! |

section drive2 from:drive
  // No hint this time: the lead rests.
  lead
    | r:4 | r:4 | r:4 | r:4 | r:4 | r:4 | r:4 | r:4 |

section reprise2 from:reprise
  // Twin leads: the hook as before, and a harmony above it. The ensemble gives
  // the harmony part a Wire of its own (its "harmony" layer), so it has
  // its own dynamic - a step under the tune,
  // which is how a harmony part is balanced - and its own vibrato, opening
  // on its own held notes rather than on the melody's.
  lead.melody dyn:mf..f feel:tight vib:warm
    | e5:0.75! g5:0.75 a5:0.75! g5:0.75~ f#5:0.5 d5:0.5 |
    | e5:2_< d5:0.5~ e5:0.5 g5:1' |
    | f#5:0.75! a5:0.75 b5:0.75! a5:0.75~ g5:0.5 e5:0.5 |
    | d#5:1.5_< f#5:0.5/ a5:1! g5:0.5~ f#5:0.5 |
    | e5:0.75! g5:0.75 a5:0.75! g5:0.75~ f#5:0.5 d5:0.5 |
    | e5:1.5_ g5:0.5/ b5:1! bb5:1~ |
    | a5:0.75!/ c6:0.75 b5:0.75! a5:0.75~ f5:0.5' e5:0.5 |
    | d#5:2_< c5:0.5! c#5:0.5! d5:0.5! d#5:0.5! |
  harmony dyn:mp..mf feel:tight vib:warm
    // Em - a third above: G B C B A F#
    | g5:0.75! b5:0.75 c6:0.75! b5:0.75~ a5:0.5 f#5:0.5 |
    // C - G held while the melody turns E D E, then B over its G
    | g5:3_< b5:1' |
    // D - a third above, with C natural: the D7 the pad is holding
    | a5:0.75! c6:0.75 d6:0.75! c6:0.75~ b5:0.5 g5:0.5 |
    // B7 - F# A, then B held over the melody's A G, falling to A
    | f#5:1.5_< a5:0.5/ b5:1.5! a5:0.5 |
    // Em - as bar 1
    | g5:0.75! b5:0.75 c6:0.75! b5:0.75~ a5:0.5 f#5:0.5 |
    // C - G B, then D held over the melody's chromatic B Bb
    | g5:1.5_ b5:0.5/ d6:2!~ |
    // Am - a third above, peaking on E6
    | c6:0.75!/ e6:0.75 d6:0.75! c6:0.75~ a5:0.5' g5:0.5 |
    // B7 - the fifth held, then the climb an octave above the melody
    | f#5:2_< c6:0.5! c#6:0.5! d6:0.5! d#6:0.5! |

// The way out. See "The ending" above.
section end bars:2
  bass dyn:f feel:tight
    | e1:4_!> r:4 |
  guitar dyn:f feel:tight art:marcato
    | [e2 b2 e3]:6! r:2 |

  perc.right dyn:f feel:tight
    | crash_big:8! |
  perc.left dyn:f feel:tight
    | snare:8! |
  perc.feet dyn:f feel:tight
    | kick:8! |
  pad dyn:mf..p
    | [g3 b3 f#4]:7 r:1 |
  // The hook's first four notes, quietly, over the ring: the hint again.
  keys dyn:mp..p feel:tight
    | r:1 e5:0.75 g5:0.75 a5:0.75 g5:1.5 r:3.25 |
  lead dyn:f vib:warm
    | e5:6_> r:2 |
