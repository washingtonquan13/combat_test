// The riff again, the band exactly as it was, with the synths on top.
section reprise from:riff
  pad dyn:mf..f
    | [g3 b3 e4]:4 | [g3 c4 e4]:4 | [f#3 c4 d4]:4 | [f#3 b3 d#4]:4^ |
    | [g3 b3 e4]:4 | [g3 c4 e4]:4 | [a3 c4 e4]:4 | [a3 b3 d#4]:4^ |

  keys dyn:mf..f feel:tight
    | e4:0.25! g4:0.25 e5:0.25 e4:0.25! g4:0.25 e5:0.25 e4:0.25! g4:0.25 e5:0.25 e4:0.25! g4:0.25 e5:0.25 b4:0.25! e5:0.25 b4:0.25! e5:0.25 |
    | c4:0.25! g4:0.25 e5:0.25 c4:0.25! g4:0.25 e5:0.25 c4:0.25! g4:0.25 e5:0.25 c4:0.25! g4:0.25 e5:0.25 c5:0.25! e5:0.25 c5:0.25! e5:0.25 |
    | d4:0.25! f#4:0.25 d5:0.25 d4:0.25! f#4:0.25 d5:0.25 d4:0.25! f#4:0.25 d5:0.25 d4:0.25! f#4:0.25 d5:0.25 c5:0.25! d5:0.25 c5:0.25! d5:0.25 |
    | b3:0.25! f#4:0.25 d#5:0.25 b3:0.25! f#4:0.25 d#5:0.25 b3:0.25! f#4:0.25 d#5:0.25 b3:0.25! f#4:0.25 d#5:0.25 b4:0.25! d#5:0.25 b4:0.25! d#5:0.25 |
    | e4:0.25! g4:0.25 e5:0.25 e4:0.25! g4:0.25 e5:0.25 e4:0.25! g4:0.25 e5:0.25 e4:0.25! g4:0.25 e5:0.25 b4:0.25! e5:0.25 b4:0.25! e5:0.25 |
    | c4:0.25! g4:0.25 e5:0.25 c4:0.25! g4:0.25 e5:0.25 c4:0.25! g4:0.25 e5:0.25 c4:0.25! g4:0.25 e5:0.25 c5:0.25! e5:0.25 c5:0.25! e5:0.25 |
    | a3:0.25! a4:0.25 e5:0.25 a3:0.25! a4:0.25 e5:0.25 a3:0.25! a4:0.25 e5:0.25 a3:0.25! a4:0.25 e5:0.25 c5:0.25! e5:0.25 c5:0.25! e5:0.25 |
    | b3:0.25! a4:0.25 d#5:0.25 b3:0.25! a4:0.25 d#5:0.25 b4:0.25! d#5:0.25 c4:0.25! c5:0.25 c#4:0.25! c#5:0.25 d4:0.25! d5:0.25 d#4:0.25! d#5:0.25! |

  // The hook. See "The hook" above.
  lead dyn:mf..f feel:tight vib:warm
    // Em - the bass's walk, E G A G, on the guitar's dotted-eighth pulse
    | e5:0.75! g5:0.75 a5:0.75! g5:0.75~ f#5:0.5 d5:0.5 |
    // C - held on E, the third the guitar leaves out
    | e5:2_< d5:0.5~ e5:0.5 g5:1' |
    // D - bar 1 a step higher: the sequence
    | f#5:0.75! a5:0.75 b5:0.75! a5:0.75~ g5:0.5 e5:0.5 |
    // B7 - the leading tone, then up to the seventh and back down to E
    | d#5:1.5_< f#5:0.5/ a5:1! g5:0.5~ f#5:0.5 |
    // Em - bar 1 again, exactly
    | e5:0.75! g5:0.75 a5:0.75! g5:0.75~ f#5:0.5 d5:0.5 |
    // C - up to B, then down Bb into A with the bass
    | e5:1.5_ g5:0.5/ b5:1! bb5:1~ |
    // Am - the peak, C6, and the flat second on the way down
    | a5:0.75!/ c6:0.75 b5:0.75! a5:0.75~ f5:0.5' e5:0.5 |
    // B7 - the leading tone held, then the band's climb in unison
    | d#5:2_< c5:0.5! c#5:0.5! d5:0.5! d#5:0.5! |

// The breakdown. See "The bridge" above.
section bridge bars:8
  // C G/B Gm/Bb Am | Fmaj7 F B7sus4-B7 B7: the bass falls a half step at a time
  bass dyn:mp..f feel:tight
    | c2:4 | b1:4 | bb1:4 | a1:4 |
    | f1:4 | f1:4 | b1:0.5! b1:0.5 b1:0.5 b1:0.5 b1:0.5! b1:0.5 b1:0.5 b1:0.5 |
