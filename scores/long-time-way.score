    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
  gallop dyn:mf feel:tight
    | trot | % | % | % | trot-5 | % | % | % |
    | trot-4 | % | % | % | trot-2 | % | % | % |
  pad dyn:mf
    | [d3 f3 a3 d4]:16 | [e3 g3 c4]:16 |
    | [d3 f3 bb3]:16 | [e3 a3 c4]:16 |
  // Second statement, and the change is the scoring rather than the volume.
  // The top line is the same bow as before, digging in at the head of each
  // phrase now that the kit is under it. The inner voice goes to tremolo:
  // the same notes, no longer held but shivering, which is how a section
  // puts unease under a melody that has not itself changed. That is the
  // whole difference between this pass and the first one.
  lead.upper dyn:mf art:sustain feel:loose pocket:lay
    | g4:4!^ | f4:4_ | g4:4^ | f4:4. |
    | e4:4_ | f4:4_ | g4:4^ | e4:4. |
    | a4:4!^ | f4:4_ | g4:4^ | a4:4^ |
    | g4:4_ | f4:4_ | e4:4. | g4:4^ |
  lower dyn:mf art:tremolo feel:loose pocket:18
    | e4:4^ | d4:4_ | e4:4_ | d4:4. |
    | c4:4_ | d4:4_ | e4:4^ | c4:4. |
    | f4:4!^ | d4:4_ | e4:4_ | f4:4^ |
    | e4:4_ | d4:4_ | c4:4. | e4:4^ |
  hats dyn:p feel:tight
    | hats | % | % | % |
    | hats | % | % | % |
    | hats | % | % | % |
    | hats | % | % | % |
  perc.left dyn:mf feel:tight
    | beat_hands | % | % | fill_hands |
    | beat_hands | % | % | roll_hands |
    | beat_hands | % | % | fill_hands |
    | beat_hands | % | % | roll_hands |
  perc.feet dyn:mf feel:tight
    | beat_feet | % | % | fill_feet |
    | beat_feet | % | % | fill_feet |
    | beat_feet | % | % | fill_feet |
    | beat_feet | % | % | roll_feet |

// The third time: the upper voice an octave higher.
section theme3 bars:16
  bass.figure dyn:f feel:tight
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
