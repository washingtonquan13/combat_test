    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
  gallop dyn:f feel:tight
    | trot | % | % | % | trot-5 | % | % | % |
    | trot-4 | % | % | % | trot-2 | % | % | % |
  pad dyn:mf..f
    | [d3 f3 a3 d4]:16 | [e3 g3 c4]:16 |
    | [d3 f3 bb3]:16 | [e3 a3 c4]:16 |
  // Third statement: the violins an octave up - the octave is the
  // original's, not ours - bowed and held as in the second statement, and
  // only the inner voice in tremolo; both voices trembling up there grated
  // every time the loop came round. With the kit under it the pair sit on
  // the beat rather than behind it. It is no louder than the second
  // statement: the octave is the climb, and on top of it a crescendo and
  // marcato accents were too much. So no `!` here - on strings it is a
  // switch to the marcato samples, not just an accent.
  lead.upper dyn:mp..mf art:sustain feel:loose pocket:on
    | g5:4^ | f5:4_ | g5:4^ | f5:4_ |
    | e5:4_ | f5:4_ | g5:4^ | e5:4. |
    | a5:4^ | f5:4_ | g5:4^ | a5:4^ |
    | g5:4_ | f5:4_ | e5:4. | g5:4^ |
  lower dyn:mf art:tremolo feel:loose pocket:on
    | e4:4^ | d4:4_ | e4:4_ | d4:4_ |
    | c4:4_ | d4:4_ | e4:4^ | c4:4. |
    | f4:4^ | d4:4_ | e4:4_ | f4:4^ |
    | e4:4_ | d4:4_ | c4:4. | e4:4^ |
  hats dyn:mp feel:tight
    | hats | % | % | % |
    | hats | % | % | % |
    | hats | % | % | % |
    | hats | % | % | % |
  perc.left dyn:f feel:tight
    | beat_hands | % | % | fill_hands |
    | beat_hands | % | % | roll_hands |
    | beat_hands | % | % | fill_hands |
    | beat_hands | % | % | roll_hands |
  perc.feet dyn:f feel:tight
    | beat_feet | % | % | fill_feet |
    | beat_feet | % | % | roll_feet |
    | beat_feet | % | % | fill_feet |
    | beat_feet | % | % | roll_feet |

// The way out: the kit stops and the held D returns, as the original ends.
section home bars:4
  bass.figure dyn:f..mp feel:tight
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 f2:0.25 e2:0.25 d2:0.25 c2:0.25 |
  lead dyn:mf..p
    | d5:16 |
  pad dyn:mp..p
    | [d3 f3 a3 d4]:16 |
  fx dyn:mf
    | crash:4! | r:4 | r:4 | r:4 |

// The way out: the figure lands on D and everything else lets go.
section end bars:2
