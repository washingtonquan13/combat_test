  lead dyn:mf
    | [d4 f4]:16^ |
  pad dyn:mp
    | [d3 f3 a3 d4]:16 |
  hats dyn:p feel:tight
    | hats | % | % | % |
  perc.left dyn:mf feel:tight
    | r:4 | r:4 | r:4 | r:2.25 snare:0.75 snare:0.5 snare:0.25 snare:0.25! |
  perc.feet dyn:mf feel:tight
    | r:4 | r:4 | r:4 | r:2 kick:2! |

// The journey: the melody again, over the kit and the galloping roots.
section theme2 bars:16
  bass.figure dyn:mf..f feel:tight
    | d1:0.25! a1:0.25 d2:0.25 c2:0.25 d2:0.25 a1:0.25 f1:0.25 g1:0.25 a1:0.25 c2:0.25 d2:0.25 c2:0.25 a1:0.25 c2:0.25 g1:0.25 a1:0.25 |
