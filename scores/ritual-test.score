// Ritual test - four bars to prove the ritual ensemble sounds.
//
// A shrine in a ruined city: monks holding a low drone, a dan tranh
// picking a minor pentatonic line, a kalimba pulse, and the kit's frame
// drums and darbuka circling a gong on the first beat.

title: Ritual Test
ensemble: ritual
parts: keys bass pad perc metal:perc@perc
tempo: 84
meter: 4/4
key: e minor
order: shrine

section shrine bars:4
  keys dyn:mf
    | e5:1 g5:0.5 a5:0.5 b5:2 | d6:1 b5:1 a5:1 g5:1 | e5:0.5 g5:0.5 a5:1 g5:1 e5:1 | e5:4 |
  bass dyn:mp
    | e2:1 e2:1 b1:1 e2:1 | e2:1 e2:1 d2:1 e2:1 | e2:1 e2:1 b1:1 e2:1 | e2:4 |
  pad dyn:p..mp
    | [e2 b2]:8 | [e2 b2 e3]:8 |
  perc.drums dyn:mf
    | frame_low:1 darbuka_1:0.5 darbuka_2:0.5 frame_high:1 darbuka_3:0.5 darbuka_2:0.5 | frame_low:1 darbuka_1:0.5 darbuka_2:0.5 frame_high:1 slit_low:0.5 slit_high:0.5 | frame_low:1 darbuka_1:0.5 darbuka_2:0.5 frame_high:1 darbuka_3:0.5 darbuka_2:0.5 | boom:4 |
  metal dyn:mf
