section break bars:8
  // The bridge is the first draft of this piece: the D pedal cell, unmoving,
  // with the chords only above it. After sixteen bars of a bass that walks
  // every change, a bass that refuses to move is the contrast. The chords over
  // it only darken - Dm, Bb, Gm, then A grinding its C# against the D - and the
  // organ sings the head of the hook an octave down. The second half adds
  // weight, not light: the chug returns on D and the kit comes in at half time.
  bass dyn:mp..mf feel:loose pocket:lay
    | cell | cell | cell | cell |
  lead dyn:p..mf feel:loose pocket:lay rot:slow
    | d4:1.5_ f4:0.5 g4:1 a4:1 |
    | a4:3_ f4:1 |
    | bb4:1.5_ a4:0.5 g4:1 f4:1 |
    | d4:3_ f4:1 |
    | g4:1.5_ bb4:0.5 d5:1 c5:1 |
    | bb4:3_ a4:1 |
    | a4:1.5! c#5:0.5 e5:1 g5:1 |
    | f5:1.5! e5:0.5 d5:1 c#5:1 |
  guitar dyn:p..mf feel:tight art:sustain pocket:lay
    | r:4 | r:4 | r:4 | r:4 |
    | d3:0.25+*16 | d3:0.25+*12 [bb2 f3 bb3]:1! |
    | d3:0.25+*16 | d3:0.25+*12 [a2 e3 a3]:1! |
  perc.feet dyn:p..f feel:tight
    | r:4 | r:4 | r:4 | r:4 |
    | kick:2! r:2 | kick:1.5! kick:0.5 r:2 |
    | kick:2! r:2 |
    | kick:1! kick:1 kick:1! kick:0.5 kick:0.5 |
  perc.left dyn:p..f feel:tight
    | r:4 | r:4 | r:4 | r:4 |
    | r:2 snare_dry:2! | r:2 snare_dry:2! |
    | r:2 snare_dry:0.5. snare_dry:0.5 snare_dry:0.5. snare_dry:0.5 |
    | snare_dry:0.25. snare_dry:0.25 snare_dry:0.25 snare_dry:0.25 snare_dry:0.25. snare_dry:0.25 snare_dry:0.25 snare_dry:0.25! snare_dry:0.25. snare_dry:0.25 snare_dry:0.25 snare_dry:0.25! snare_dry:0.25! snare_dry:0.25! snare_dry:0.25! snare_dry:0.25! |
  pad dyn:p..mf
    | [f4 a4]:4 | [f4 a4]:4 | [d4 f4]:4 | [d4 f4]:4^ |
    | [d4 bb4]:4 | [d4 bb4]:4 | [c#4 g4]:4 | [c#4 g4]:4^ |

section reprise from:verse
  lead dyn:f..ff feel:tight pocket:lay rot:fast
    | hook |
  guitar dyn:f..ff feel:tight art:sustain pocket:on
    | engine |
  keys dyn:mf..f feel:tight pocket:on
    | glint |
  perc.right dyn:f..ff feel:tight
    | crash_big:0.5! hat:0.5. hat:0.5 hat:0.5. hat:0.5 hat:0.5. hat:0.5 hat:0.5. |
    | hats | hats | hats |
    | crash:0.5! hat:0.5. hat:0.5 hat:0.5. hat:0.5 hat:0.5. hat:0.5 hat:0.5. |
    | hats | hats |
    | crash_big:0.5! r:1.5 crash:0.5! r:1.5 |

