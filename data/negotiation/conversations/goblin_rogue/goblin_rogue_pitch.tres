[sub_resource type="Resource" id="Resource_recruit"]
script = ExtResource("3_outcome")
outcome = 1
text = "Fine. Prove it's true and you've got a deal."

[sub_resource type="Resource" id="Resource_pressed"]
script = ExtResource("4_line")
next_node_id = "goblin_rogue_pressed"
text = "And the moment a better offer comes along?"

[resource]
script = ExtResource("1_node")
id = "goblin_rogue_pitch"
text_block = "I know where three separate patrols dodge sightlines. I know which locks pop soft. Point me at a fight, I fight. Point me at a door, it opens. That's worth keeping alive, isn't it?"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_recruit"), SubResource("Resource_pressed")])
