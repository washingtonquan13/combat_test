text = "That's exactly why I don't trust you."

[resource]
script = ExtResource("1_node")
id = "goblin_rogue_shrug"
text_block = "Betray? No such thing between goblins who never swore anything. Every one of us is looking out for our own hide first. You'd know that too, if you were smart about it."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_recruit"), SubResource("Resource_attack")])
