[sub_resource type="Resource" id="Resource_reading"]
script = ExtResource("3_line")
next_node_id = "goblin_shaman_reading"
text = "Then look. I've nothing to hide."

[sub_resource type="Resource" id="Resource_plain"]
script = ExtResource("3_line")
