[gd_resource type="Resource" script_class="DialogueNode" load_steps=7 format=3]

[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_node.gd" id="1_node"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_outcome_choice.gd" id="3_outcome"]

[sub_resource type="Resource" id="Resource_recruit"]
script = ExtResource("3_outcome")
outcome = 1
text = "[Offer it a direction to flow.]"

[sub_resource type="Resource" id="Resource_attack"]
script = ExtResource("3_outcome")
outcome = 3
text = "[It isn't listening. Strike first.]"

[sub_resource type="Resource" id="Resource_flee"]
script = ExtResource("3_outcome")
outcome = 2
text = "[Step out of its path instead.]"

[resource]
script = ExtResource("1_node")
id = "element_greeting"
text_block = "It doesn't speak. It doesn't seem to hear you, exactly, so much as register that something is standing where it wants to be. There's no reasoning with weather — only redirecting it, resisting it, or getting out of its way."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_recruit"), SubResource("Resource_attack"), SubResource("Resource_flee")])
