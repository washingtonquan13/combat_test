[gd_resource type="Resource" script_class="DialogueNode" load_steps=8 format=3]

[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_node.gd" id="1_node"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_line_choice.gd" id="3_line"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_outcome_choice.gd" id="4_outcome"]

[sub_resource type="Resource" id="Resource_war"]
script = ExtResource("3_line")
next_node_id = "wargod_war"
text = "I can offer you a war worth fighting. This isn't it."

[sub_resource type="Resource" id="Resource_attack"]
script = ExtResource("4_outcome")
outcome = 3
text = "Any war's a good war. Let's start with this one."

[resource]
script = ExtResource("1_node")
id = "wargod_greeting"
text_block = "[It's already grinning, weapon loose in hand, delighted at the prospect regardless of how this goes.] Finally, someone worth the effort of drawing steel for. Shall we begin, or did you come to talk instead?"
choices = Array[ExtResource("2_choice")]([SubResource("Resource_war"), SubResource("Resource_attack")])
