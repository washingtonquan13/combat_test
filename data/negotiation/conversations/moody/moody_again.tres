[gd_resource type="Resource" script_class="DialogueNode" load_steps=16 format=3]

[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_node.gd" id="1_node"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://systems/dialogue_system/line_choice.gd" id="3_line_choice"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_effect.gd" id="4_effect_base"]
[ext_resource type="Script" path="res://systems/negotiation_system/volatile_mood_effect.gd" id="5_mood"]
[ext_resource type="Script" path="res://systems/negotiation_system/spend_pardon_effect.gd" id="92_pardon_effect"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_outcome_effect.gd" id="91_outcome_effect"]

[sub_resource type="Resource" id="Resource_liked_mood"]
script = ExtResource("5_mood")
min_amount = 1
max_amount = 4

[sub_resource type="Resource" id="Resource_liked"]
script = ExtResource("3_line_choice")
next_node_id = "moody_request"
text = "Take your time. I'm not going anywhere."
effects = Array[ExtResource("4_effect_base")]([SubResource("Resource_liked_mood")])

[sub_resource type="Resource" id="Resource_neutral_mood"]
script = ExtResource("5_mood")
min_amount = -2
max_amount = 3

[sub_resource type="Resource" id="Resource_neutral"]
script = ExtResource("3_line_choice")
next_node_id = "moody_request"
text = "...Okay. Sure. Whatever works."
effects = Array[ExtResource("4_effect_base")]([SubResource("Resource_neutral_mood")])

[sub_resource type="Resource" id="Resource_disliked_ending"]
script = ExtResource("92_pardon_effect")

[sub_resource type="Resource" id="Resource_disliked"]
script = ExtResource("3_line_choice")
next_node_id = "moody_request"
text = "Could you just make up your mind?"
effects = Array[ExtResource("4_effect_base")]([SubResource("Resource_disliked_ending")])

[sub_resource type="Resource" id="Resource_hated_ending"]
script = ExtResource("91_outcome_effect")
outcome = 3

[sub_resource type="Resource" id="Resource_hated"]
script = ExtResource("3_line_choice")
text = "Honestly, you seem pretty unstable."
effects = Array[ExtResource("4_effect_base")]([SubResource("Resource_hated_ending")])

[resource]
script = ExtResource("1_node")
id = "moody_again"
text_block = "Good. GOOD. Or bad. I genuinely can't tell yet. Say something else, quickly."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_liked"), SubResource("Resource_neutral"), SubResource("Resource_disliked"), SubResource("Resource_hated")])
