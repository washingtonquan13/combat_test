[gd_resource type="Resource" script_class="DialogueNode" load_steps=6 format=3]

[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_node.gd" id="1_node"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_outcome_choice.gd" id="3_outcome"]

[sub_resource type="Resource" id="Resource_recruit"]
script = ExtResource("3_outcome")
outcome = 1
text = "Then finish it walking with me. Do some good before you go."

[sub_resource type="Resource" id="Resource_heal"]
script = ExtResource("3_outcome")
outcome = 4
text = "Then let me help someone right now, while you're still here."

[resource]
script = ExtResource("1_node")
id = "haunt_unfinished"
text_block = "...Nobody's asked that either. Something undone. I don't remember what, most days — just the shape of the wanting, not the reason for it anymore."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_recruit"), SubResource("Resource_heal")])
