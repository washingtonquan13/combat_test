[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_outcome_choice.gd" id="4_outcome"]

[sub_resource type="Resource" id="Resource_unfinished"]
script = ExtResource("3_line")
next_node_id = "haunt_unfinished"
text = "What's keeping you here?"

[sub_resource type="Resource" id="Resource_attack"]
script = ExtResource("4_outcome")
outcome = 3
text = "Whatever it is, it's not my problem."

[resource]
script = ExtResource("1_node")
id = "haunt_greeting"
text_block = "[Its voice arrives a half-second after its mouth moves, like an echo that hasn't caught up yet.] You can see me. Most can't, this close to solid. That usually means you want something from me too."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_unfinished"), SubResource("Resource_attack")])
