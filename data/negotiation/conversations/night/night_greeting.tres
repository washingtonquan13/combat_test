[gd_resource type="Resource" script_class="DialogueNode" load_steps=8 format=3]

[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_node.gd" id="1_node"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_line_choice.gd" id="3_line"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_outcome_choice.gd" id="4_outcome"]

[sub_resource type="Resource" id="Resource_discreet"]
script = ExtResource("3_line")
next_node_id = "night_discreet"
text = "This stays between us. I'm not here to expose anything."

[sub_resource type="Resource" id="Resource_flee"]
script = ExtResource("4_outcome")
outcome = 2
text = "[It's already gone before you finish reaching for a weapon.]"

[resource]
script = ExtResource("1_node")
id = "night_greeting"
text_block = "[It hasn't moved, but somehow you only just now noticed it was there.] You found me. That's either impressive or a mistake on my part. Convince me it's the first one."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_discreet"), SubResource("Resource_flee")])
