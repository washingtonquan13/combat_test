[gd_resource type="Resource" script_class="DialogueNode" load_steps=10 format=3]

[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_node.gd" id="1_node"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_outcome_choice.gd" id="3_outcome"]
[ext_resource type="Script" path="res://systems/skill_system/alignment_prerequisite.gd" id="4_alignment"]

[sub_resource type="Resource" id="Resource_alignment_gate"]
script = ExtResource("4_alignment")
axis = 0
required_category = 1

[sub_resource type="Resource" id="Resource_recruit"]
script = ExtResource("3_outcome")
outcome = 1
text = "[Stand fast under the judgment. Say nothing.]"
prerequisites = SubResource("Resource_alignment_gate")

[sub_resource type="Resource" id="Resource_attack"]
script = ExtResource("3_outcome")
outcome = 3
text = "I don't need a verdict from you."

[resource]
script = ExtResource("1_node")
id = "seraph_greeting"
text_block = "Order is weighed, not argued. I have already measured the shape of your conduct against the law that binds it, and I do not offer a second measurement to those found wanting."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_recruit"), SubResource("Resource_attack")])
