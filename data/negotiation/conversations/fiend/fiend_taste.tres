[resource]
script = ExtResource("1_node")
id = "fiend_taste"
text_block = "...Huh. Most flinch the instant they feel it coming. You just watched it happen. That's not bravery, exactly. Something colder. I find I like it."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_recruit"), SubResource("Resource_attack")])
