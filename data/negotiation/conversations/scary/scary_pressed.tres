[gd_resource type="Resource" script_class="DialogueNode" load_steps=10 format=3]

[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_node.gd" id="1_node"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://systems/dialogue_system/line_choice.gd" id="3_line_choice"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_effect.gd" id="90_effect_base"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_outcome_effect.gd" id="91_outcome_effect"]

[sub_resource type="Resource" id="Resource_recruit_ending"]
script = ExtResource("91_outcome_effect")
outcome = 1

[sub_resource type="Resource" id="Resource_recruit"]
script = ExtResource("3_line_choice")
text = "...Nothing beneath me refuses me twice. Fine. Follow, then — as an equal."
effects = Array[ExtResource("90_effect_base")]([SubResource("Resource_recruit_ending")])

[sub_resource type="Resource" id="Resource_attack_ending"]
script = ExtResource("91_outcome_effect")
outcome = 3

[sub_resource type="Resource" id="Resource_attack"]
script = ExtResource("3_line_choice")
text = "Then you'll learn why tribute was the wiser choice."
effects = Array[ExtResource("90_effect_base")]([SubResource("Resource_attack_ending")])

[resource]
script = ExtResource("1_node")
id = "scary_pressed"
text_block = "...Refused. Twice defiant, now. That is either very brave, or very foolish."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_recruit"), SubResource("Resource_attack")])
