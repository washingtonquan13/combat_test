[gd_resource type="Resource" script_class="DialogueNode" load_steps=11 format=3]

[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_node.gd" id="1_node"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_line_choice.gd" id="3_line"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_outcome_choice.gd" id="4_outcome"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_effect.gd" id="5_effect"]
[ext_resource type="Script" path="res://systems/dialogue_system/sacrifice_hp_effect.gd" id="6_sacrifice"]

[sub_resource type="Resource" id="Resource_challenged"]
script = ExtResource("3_line")
next_node_id = "hobgoblin_challenged"
text = "Then let my blade speak. I bested you already."

[sub_resource type="Resource" id="Resource_sacrifice_effect"]
script = ExtResource("6_sacrifice")
amount = 5

[sub_resource type="Resource" id="Resource_respect"]
script = ExtResource("3_line")
next_node_id = "hobgoblin_respect"
text = "Test me, then. I won't flinch."
dialogue_line = "[stands their ground, takes the blow without a sound]"
effects = Array[ExtResource("5_effect")]([SubResource("Resource_sacrifice_effect")])

[sub_resource type="Resource" id="Resource_attack"]
script = ExtResource("4_outcome")
outcome = 3
text = "I don't have time for goblin pride."

[resource]
script = ExtResource("1_node")
id = "hobgoblin_greeting"
text_block = "You've beaten my scouts. Fine. But words are cheap — I don't kneel for a mouth, I kneel for a blade that's earned it."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_challenged"), SubResource("Resource_respect"), SubResource("Resource_attack")])
