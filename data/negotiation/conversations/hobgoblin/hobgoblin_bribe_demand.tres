[gd_resource type="Resource" script_class="DialogueNode" load_steps=17 format=3]

[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_node.gd" id="1_node"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_choice.gd" id="2_choice"]
[ext_resource type="Script" path="res://systems/negotiation_system/negotiation_outcome_choice.gd" id="3_outcome"]
[ext_resource type="Script" path="res://systems/dialogue_system/dialogue_effect.gd" id="4_effect_base"]
[ext_resource type="Script" path="res://systems/skill_system/negotiated_gold_prerequisite.gd" id="5_gold_gate"]
[ext_resource type="Script" path="res://systems/negotiation_system/sacrifice_negotiated_gold_effect.gd" id="6_pay_gold"]
[ext_resource type="Script" path="res://systems/negotiation_system/shift_mood_effect.gd" id="7_mood"]
[ext_resource type="Script" path="res://systems/skill_system/mood_prerequisite.gd" id="8_mood_gate"]

[sub_resource type="Resource" id="Resource_gold_gate"]
script = ExtResource("5_gold_gate")

[sub_resource type="Resource" id="Resource_pay_gold"]
script = ExtResource("6_pay_gold")

[sub_resource type="Resource" id="Resource_pay_mood"]
script = ExtResource("7_mood")
amount = 2

[sub_resource type="Resource" id="Resource_pay"]
script = ExtResource("3_outcome")
outcome = 2
text = "Here — take it and go."
prerequisites = SubResource("Resource_gold_gate")
effects = Array[ExtResource("4_effect_base")]([SubResource("Resource_pay_gold"), SubResource("Resource_pay_mood")])

[sub_resource type="Resource" id="Resource_refuse_mood"]
script = ExtResource("7_mood")
amount = -3

[sub_resource type="Resource" id="Resource_refuse"]
script = ExtResource("3_outcome")
outcome = 3
text = "Not a copper. Fight or don't."
effects = Array[ExtResource("4_effect_base")]([SubResource("Resource_refuse_mood")])

[sub_resource type="Resource" id="Resource_mood_gate"]
script = ExtResource("8_mood_gate")
minimum_mood = 2

[sub_resource type="Resource" id="Resource_talk_down"]
script = ExtResource("3_outcome")
outcome = 1
text = "You said it yourself — you kneel for a blade that's earned it. I already have."
prerequisites = SubResource("Resource_mood_gate")

[resource]
script = ExtResource("1_node")
id = "hobgoblin_bribe_demand"
text_block = "...Coin. Not blood, not fear — coin. Fine, I can respect a practical offer. {gold} gold, and I forget this ever happened."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_pay"), SubResource("Resource_refuse"), SubResource("Resource_talk_down")])
