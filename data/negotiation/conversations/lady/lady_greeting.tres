[sub_resource type="Resource" id="Resource_courtesy"]
script = ExtResource("3_line")
next_node_id = "lady_courtesy"
text = "My apologies for the abrupt introduction. May I have a moment of your time?"

[sub_resource type="Resource" id="Resource_attack"]
script = ExtResource("4_outcome")
outcome = 3
text = "I don't have patience for manners right now."

[resource]
script = ExtResource("1_node")
id = "lady_greeting"
text_block = "You've drawn a blade in my presence without so much as an introduction. I confess I'm more insulted by the rudeness than frightened by the blade."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_courtesy"), SubResource("Resource_attack")])
