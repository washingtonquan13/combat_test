[gd_resource type="Resource" script_class="Advantage" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/ability_system/status_behavior.gd" id="1_base"]
[ext_resource type="Script" path="res://systems/ability_system/catfall_behavior.gd" id="2_behavior"]
[ext_resource type="Script" path="res://systems/advantage_system/advantage.gd" id="3_advantage"]

[sub_resource type="Resource" id="Resource_behavior"]
script = ExtResource("2_behavior")
ignored_fall = 4.5

[resource]
script = ExtResource("3_advantage")
id = &"catfall"
advantage_name = "Catfall"
description = "You always land on your feet. Ignore the first 4.5 m of any fall, and a successful DX roll halves the damage from the rest."
max_level = 1
behaviors = Array[ExtResource("1_base")]([SubResource("Resource_behavior")])
