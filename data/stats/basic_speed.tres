[gd_resource type="Resource" script_class="StatDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://systems/stat_system/stat_definition.gd" id="1_stat"]

[resource]
script = ExtResource("1_stat")
id = &"BasicSpeed"
display_name = "Basic Speed"
abbreviation = "Speed"
description = "Turn order: highest acts first, ties to the higher DX. Dodge is built on it."
order = 75
kind = 1
formula = "(DX + HT) / 4.0"
