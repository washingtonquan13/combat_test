[gd_resource type="Resource" script_class="RuneItem" load_steps=7 format=3]

[ext_resource type="Script" path="res://systems/inventory_system/rune_item.gd" id="1_rune"]
[ext_resource type="Script" path="res://systems/inventory_system/item_modifier.gd" id="2_mod"]
[ext_resource type="Script" path="res://systems/ability_system/stat_modifier_behavior.gd" id="3_stat"]
[ext_resource type="Texture2D" path="res://assets/test_item_icons/test_rune_iron.png" id="4_icon"]

[sub_resource type="Resource" id="Resource_weapon"]
script = ExtResource("2_mod")
label = "+1 damage"
damage_bonus = 1

[sub_resource type="Resource" id="Resource_stat"]
script = ExtResource("3_stat")
stat_name = &"DR"
amount = 1

[sub_resource type="Resource" id="Resource_armor"]
script = ExtResource("2_mod")
label = "+1 DR"
stat_modifiers = Array[ExtResource("3_stat")]([SubResource("Resource_stat")])

[resource]
script = ExtResource("1_rune")
on_weapon = SubResource("Resource_weapon")
on_armor = SubResource("Resource_armor")
id = &"iron_rune"
item_name = "Iron Rune"
icon = ExtResource("4_icon")
maximum_stack_count = 99
