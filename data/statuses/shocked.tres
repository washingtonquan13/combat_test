[gd_resource type="Resource" script_class="StatusEffect" load_steps=7 format=3]

[ext_resource type="Script" path="res://systems/ability_system/status_behavior.gd" id="1_behavior"]
[ext_resource type="Script" path="res://systems/ability_system/incapacitate_behavior.gd" id="2_incap"]
[ext_resource type="Script" path="res://systems/ability_system/stat_modifier_behavior.gd" id="3_statmod"]
[ext_resource type="Script" path="res://systems/ability_system/status_effect.gd" id="4_status"]

[sub_resource type="Resource" id="Resource_incap"]
script = ExtResource("2_incap")

[sub_resource type="Resource" id="Resource_dodge"]
script = ExtResource("3_statmod")
stat_name = &"Dodge"
amount = -4

[resource]
script = ExtResource("4_status")
status_name = "Shocked"
default_duration = 2
stack_mode = 0
max_stacks = 1
behaviors = Array[ExtResource("1_behavior")]([SubResource("Resource_incap"), SubResource("Resource_dodge")])
curable = true
resisted_by = &"HT"
