[gd_resource type="Resource" script_class="StatusEffect" load_steps=6 format=3]

[ext_resource type="Script" path="res://systems/ability_system/status_behavior.gd" id="1_behavior"]
[ext_resource type="Script" path="res://systems/ability_system/rooted_behavior.gd" id="2_rooted"]
[ext_resource type="Script" path="res://systems/ability_system/stat_modifier_behavior.gd" id="3_statmod"]
[ext_resource type="Script" path="res://systems/ability_system/status_effect.gd" id="4_status"]
[ext_resource type="Texture2D" path="res://assets/ability_icon/web_icon.png" id="5_icon"]

[sub_resource type="Resource" id="Resource_rooted"]
script = ExtResource("2_rooted")

[sub_resource type="Resource" id="Resource_dodge"]
script = ExtResource("3_statmod")
stat_name = &"Dodge"
amount = -3

[resource]
script = ExtResource("4_status")
status_name = "Webbed"
icon = ExtResource("5_icon")
default_duration = 1
stack_mode = 0
max_stacks = 1
behaviors = Array[ExtResource("1_behavior")]([SubResource("Resource_rooted"), SubResource("Resource_dodge")])
curable = true
resisted_by = &"ST"
