skill_name = "Basic Attack"
controlling_attribute = "DX"
difficulty_level = -3
defaults = Array[ExtResource("2_default")]([SubResource("Resource_default")])
description = "A single unified skill for landing any attack — melee, ranged, unarmed, any weapon — instead of a separate skill per weapon type. Very Hard difficulty, reflecting how broad it is (in the spirit of GURPS' Wildcard skills, which cover a whole domain at a steep cost) — real investment is needed before it beats just defaulting off DX untrained."
