script = ExtResource("1_node")
id = "townsperson_quest_location"
speaker = "npc"
text_block = "Somewhere out past the old quarry, if I had to guess — that's the direction they always come from, and where the tracks lead back to. Nobody from town's been foolish enough to go look and confirm it themselves. If you're thinking about it... just be careful. Please."
next_node_id = "townsperson_hub"
