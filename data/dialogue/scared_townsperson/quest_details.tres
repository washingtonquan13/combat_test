[sub_resource type="Resource" id="Resource_location"]
script = ExtResource("3_line")
next_node_id = "townsperson_quest_location"
text = "Do you know where they're camped?"
dialogue_line = "Do you know where they're camped?"

[sub_resource type="Resource" id="Resource_push"]
script = ExtResource("4_contest")
skill_name = "Persuasion"
npc_skill_name = "Insight"
success_node_id = "townsperson_quest_location"
failure_node_id = "townsperson_quest_pushed_back"
