[resource]
script = ExtResource("1_node")
id = "townsperson_quest_details"
speaker = "npc"
text_block = "Three nights back they hit the Hollis farm — burned the grain store, took what livestock they could herd off, and put an arrow through Old Hollis's leg when he came out swinging a torch at them. Before that it was the mill. Before that, some fool who wandered too close to the tree line at dusk never came home at all. They don't come every night. Just enough that nobody sleeps easy anymore."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_location"), SubResource("Resource_push"), SubResource("Resource_watch")])
