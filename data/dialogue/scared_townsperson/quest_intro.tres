[resource]
script = ExtResource("1_node")
id = "townsperson_quest_intro"
speaker = "npc"
text_block = "You mean the raids. Goblins, mostly — small bands, quick and mean — but there's bigger ones running with them now. Uglier, smarter, giving the orders. It's gotten worse these past few months."
choices = Array[ExtResource("2_choice")]([SubResource("Resource_details"), SubResource("Resource_insight"), SubResource("Resource_sympathy"), SubResource("Resource_dismiss")])
interjection_options = Array[ExtResource("5_dlgrootopt")]([SubResource("Resource_dwarf_reaction_option")])
