[resource]
script = ExtResource("1_node")
id = "townsperson_resolved_hub"
speaker = "npc"
text_block = "They're gone. All of them — no torches on the treeline last night, first time since this started. I keep waiting to hear something moving out there, and there's nothing. I don't have the words for what you did for this town."
