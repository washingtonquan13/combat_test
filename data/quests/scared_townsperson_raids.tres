[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3]

[ext_resource type="Script" path="res://systems/quest_system/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://systems/quest_system/quest_stage.gd" id="2_stage"]

[sub_resource type="Resource" id="Resource_stage_heard"]
script = ExtResource("2_stage")
flag_name = "townsperson_heard_raids"
journal_text = "A frightened woman on the edge of town told me goblin raiders — something bigger and smarter leading them now — have been hitting farms and travelers nearby. She thinks they're camped somewhere past the old quarry. I should find them and put a stop to the raids."

[sub_resource type="Resource" id="Resource_stage_resolved"]
script = ExtResource("2_stage")
flag_name = "townsperson_raids_resolved"
journal_text = "The goblin raiders are dead. The attacks on the town have stopped."

[resource]
script = ExtResource("1_quest")
id = "scared_townsperson_raids"
title = "Raiders at the Gate"
stages = Array[ExtResource("2_stage")]([SubResource("Resource_stage_heard"), SubResource("Resource_stage_resolved")])
