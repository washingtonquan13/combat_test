[configuration]
entry_symbol = "navigation_grid_library_init"
compatibility_minimum = "4.4"
reloadable = true

[libraries]
windows.debug.x86_64 = "res://bin/win64/libnavigationgrid.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/win64/libnavigationgrid.windows.template_release.x86_64.dll"
