extends RefCounted

# Carries a motion generated by Kimodo (NVIDIA's text-to-motion model, run
# here through kimodo.cpp) onto the mannequin's GeneralSkeleton.
#
# Kimodo's SOMA model gives, 30 times a second, a root position and a local
# rotation for each of 30 joints. Both skeletons rest in a T-pose facing +Z
# with Y up, so a joint's turn from rest in the world is the same turn on
# our bone: each of our bones takes its SOMA joint's world rotation, after a
# small fixed correction for the two rests not pointing a bone exactly the
# same way, and is then written local to its parent. The hips' travel is
# scaled by the two bodies' leg lengths, so feet that were planted stay
# planted. SOMA has no fingers; they are held as a clip of ours has them.

const FPS := 30.0

const NAMES: PackedStringArray = [
	"Hips", "Spine1", "Spine2", "Chest", "Neck1", "Neck2", "Head", "Jaw",
	"LeftEye", "RightEye", "LeftShoulder", "LeftArm", "LeftForeArm", "LeftHand",
	"LeftHandThumbEnd", "LeftHandMiddleEnd", "RightShoulder", "RightArm", "RightForeArm",
	"RightHand", "RightHandThumbEnd", "RightHandMiddleEnd", "LeftLeg", "LeftShin", "LeftFoot",
	"LeftToeBase", "RightLeg", "RightShin", "RightFoot", "RightToeBase"]
const PARENTS: PackedInt32Array = [-1, 0, 1, 2, 3, 4, 5, 6, 6, 6, 3, 10, 11, 12, 13, 13, 3, 16, 17, 18, 19, 19, 0, 22, 23, 24, 0, 26, 27, 28]
const OFFSETS: PackedVector3Array = [
	Vector3(0.0, 0.0, 0.0), Vector3(-0.00013727, 0.0500376256, -0.00053726669), Vector3(0.0, 0.0712530139, -0.000298248546),
	Vector3(0.0, 0.0755006305, -0.00815970992), Vector3(-0.00181676517, 0.263112953, -0.00553348292),
	Vector3(0.0, 0.0770939664, 0.0230258546), Vector3(0.0, 0.0612891595, 0.0195370861),
	Vector3(2.63687901e-05, 0.0047559225, 0.0309494062), Vector3(0.0320638079, 0.0538020513, 0.0758688308),
	Vector3(-0.0322244017, 0.05361869, 0.0755823359), Vector3(0.0162165175, 0.232371641, 0.0511341324),
	Vector3(0.149198457, 0.0, -0.0550232576), Vector3(0.287393078, 0.0, -2.58787737e-05),
	Vector3(0.270939812, 0.0, 2.60897248e-05), Vector3(0.122686267, -0.0322017573, 0.0483306876),
	Vector3(0.190119595, -0.00312878387, -0.000339570373), Vector3(-0.0138011824, 0.231803086, 0.0521415786),
	Vector3(-0.150371962, 0.0, -0.0554560437), Vector3(-0.287366393, 0.0, -2.59709359e-05),
	Vector3(-0.271336198, 0.0, 2.61269368e-05), Vector3(-0.122642483, -0.0321145448, 0.0480403904),
	Vector3(-0.190005945, -0.00306615542, -0.0003157343), Vector3(0.10043214, -0.0843452671, 0.0259565473),
	Vector3(0.0, -0.432217537, -0.00802912805), Vector3(0.0, -0.421550959, -0.0348152298),
	Vector3(0.0, -0.0505947206, 0.132315294), Vector3(-0.10047278, -0.0829525995, 0.0262031695),
	Vector3(0.0, -0.433622059, -0.00805555828), Vector3(0.0, -0.421173943, -0.0347839785),
	Vector3(0.0, -0.0507960932, 0.132841956)]

# Our bone -> [SOMA joint, the SOMA joint it points at, our bone it points
# at]. An empty pointing pair takes the joint's turn as it is.
const MAP := {
	"Hips": ["Hips", "", ""],
	"Spine": ["Spine1", "Spine2", "Chest"],
	"Chest": ["Spine2", "Chest", "UpperChest"],
	"UpperChest": ["Chest", "Neck1", "Neck"],
	"Neck": ["Neck1", "Head", "Head"],
	"Head": ["Head", "", ""],
	"LeftShoulder": ["LeftShoulder", "LeftArm", "LeftUpperArm"],
	"LeftUpperArm": ["LeftArm", "LeftForeArm", "LeftLowerArm"],
	"LeftLowerArm": ["LeftForeArm", "LeftHand", "LeftHand"],
	"LeftHand": ["LeftHand", "LeftHandMiddleEnd", "LeftMiddleProximal"],
	"RightShoulder": ["RightShoulder", "RightArm", "RightUpperArm"],
	"RightUpperArm": ["RightArm", "RightForeArm", "RightLowerArm"],
	"RightLowerArm": ["RightForeArm", "RightHand", "RightHand"],
	"RightHand": ["RightHand", "RightHandMiddleEnd", "RightMiddleProximal"],
	"LeftUpperLeg": ["LeftLeg", "LeftShin", "LeftLowerLeg"],
	"LeftLowerLeg": ["LeftShin", "LeftFoot", "LeftFoot"],
	"LeftFoot": ["LeftFoot", "LeftToeBase", "LeftToes"],
	"LeftToes": ["LeftToeBase", "", ""],
	"RightUpperLeg": ["RightLeg", "RightShin", "RightLowerLeg"],
	"RightLowerLeg": ["RightShin", "RightFoot", "RightFoot"],
	"RightFoot": ["RightFoot", "RightToeBase", "RightToes"],
	"RightToes": ["RightToeBase", "", ""],
}

var frames: int = 0
var _roots: PackedFloat32Array
var _turns: PackedFloat32Array


## Reads a kmd-generate output folder. False when it is not one.
func read(dir: String) -> bool:
	_roots = FileAccess.get_file_as_bytes(dir.path_join("root_positions.f32")).to_float32_array()
	_turns = FileAccess.get_file_as_bytes(dir.path_join("local_rotations_xyzw.f32")).to_float32_array()
	frames = _roots.size() / 3
	return frames > 0 and _turns.size() == frames * NAMES.size() * 4


func root(frame: int) -> Vector3:
	return Vector3(_roots[frame * 3], _roots[frame * 3 + 1], _roots[frame * 3 + 2])


## What to place the motion by so that on `frame` the body stands over the
## origin facing +Z. Kimodo starts a motion facing any way it likes.
func squared(frame: int = 0) -> Transform3D:
	var hips: Transform3D = world(frame)[0]
	var ahead: Vector3 = hips.basis.z
	var turn := Basis(Vector3.UP, -atan2(ahead.x, ahead.z))
	var at: Vector3 = turn * hips.origin
	return Transform3D(turn, Vector3(-at.x, 0.0, -at.z))


## Every SOMA joint's world transform on a frame, in metres.
func world(frame: int) -> Array[Transform3D]:
	var out: Array[Transform3D] = []
	out.resize(NAMES.size())
	for j in NAMES.size():
		var at: int = (frame * NAMES.size() + j) * 4
		var turn := Basis(Quaternion(_turns[at], _turns[at + 1], _turns[at + 2], _turns[at + 3]).normalized())
		if PARENTS[j] < 0:
			out[j] = Transform3D(turn, root(frame))
		else:
			out[j] = out[PARENTS[j]] * Transform3D(turn, OFFSETS[j])
	return out


## The motion from frame `from` to `to` as a clip on `skeleton`. Fingers
## hold as `fingers` has them at `fingers_time` (none = at rest). `placed`
## moves the whole motion first (its start onto the origin, say).
## `per_frame`, when given, holds one placement per frame from `from` to
## `to` and is used instead of `placed`: a clip played in place, its travel
## and turn taken out frame by frame (make_locomotion.gd).
func animation(skeleton: Skeleton3D, from: int = 0, to: int = -1, placed := Transform3D.IDENTITY,
		fingers: Animation = null, fingers_time: float = 0.0, per_frame: Array[Transform3D] = []) -> Animation:
	if to < 0:
		to = frames - 1
	var anim := Animation.new()
	anim.length = (to - from) / FPS
	var hips_track: int = anim.add_track(Animation.TYPE_POSITION_3D)
	anim.track_set_path(hips_track, NodePath("%GeneralSkeleton:Hips"))

	var order: Array[int] = []
	var fix := {}
	var soma_of := {}
	var track_of := {}
	for i in skeleton.get_bone_count():
		var bone: String = skeleton.get_bone_name(i)
		if not MAP.has(bone):
			continue
		order.append(i)
		soma_of[i] = NAMES.find(MAP[bone][0])
		fix[i] = _rest_fix(skeleton, i, MAP[bone]) * skeleton.get_bone_global_rest(i).basis
		track_of[i] = anim.add_track(Animation.TYPE_ROTATION_3D)
		anim.track_set_path(track_of[i], NodePath("%GeneralSkeleton:" + bone))

	var scale: float = _leg(skeleton) / (OFFSETS[23].length() + OFFSETS[24].length())
	var hips: int = skeleton.find_bone("Hips")
	var hips_rest: Vector3 = skeleton.get_bone_global_rest(hips).origin
	# SOMA's hips at rest, scaled, sit where ours do; what is left over is
	# the two bodies' difference in build, kept as a fixed lift.
	var lift: float = hips_rest.y - _soma_rest_hips_height() * scale
	for f in range(from, to + 1):
		var t: float = (f - from) / FPS
		var joints: Array[Transform3D] = world(f)
		if not per_frame.is_empty():
			placed = per_frame[f - from]
		var ours := {}
		for i in order:
			var basis: Basis = placed.basis * joints[soma_of[i]].basis * fix[i]
			ours[i] = basis
			var parent: int = skeleton.get_bone_parent(i)
			var local: Basis = basis
			if ours.has(parent):
				local = (ours[parent] as Basis).inverse() * basis
			elif parent >= 0:
				local = skeleton.get_bone_global_rest(parent).basis.inverse() * basis
			anim.rotation_track_insert_key(track_of[i], t, local.get_rotation_quaternion())
		var at: Vector3 = (placed * joints[0].origin) * scale + Vector3(0.0, lift, 0.0)
		anim.position_track_insert_key(hips_track, t, at)

	if fingers:
		for i in fingers.get_track_count():
			var path: String = String(fingers.track_get_path(i))
			var bone: String = path.get_slice(":", 1)
			if fingers.track_get_type(i) != Animation.TYPE_ROTATION_3D or MAP.has(bone):
				continue
			var track: int = anim.add_track(Animation.TYPE_ROTATION_3D)
			anim.track_set_path(track, fingers.track_get_path(i))
			anim.rotation_track_insert_key(track, 0.0, fingers.rotation_track_interpolate(i, fingers_time))
	return anim


# The turn that takes our bone's rest direction to the SOMA joint's, so a
# limb that rests a few degrees off SOMA's still ends up pointing where
# SOMA's does.
func _rest_fix(skeleton: Skeleton3D, bone: int, entry: Array) -> Basis:
	if entry[1] == "":
		return Basis.IDENTITY
	var child: int = skeleton.find_bone(entry[2])
	if child < 0:
		return Basis.IDENTITY
	var ours: Vector3 = skeleton.get_bone_global_rest(child).origin - skeleton.get_bone_global_rest(bone).origin
	var theirs: Vector3 = OFFSETS[NAMES.find(entry[1])]
	# A hand's middle fingertip against our middle knuckle: both lie along
	# the hand, so the direction is the same thing.
	if ours.length() < 0.001 or theirs.length() < 0.001:
		return Basis.IDENTITY
	return Basis(Quaternion(ours.normalized(), theirs.normalized()))


func _leg(skeleton: Skeleton3D) -> float:
	var hip: Vector3 = skeleton.get_bone_global_rest(skeleton.find_bone("LeftUpperLeg")).origin
	var knee: Vector3 = skeleton.get_bone_global_rest(skeleton.find_bone("LeftLowerLeg")).origin
	var ankle: Vector3 = skeleton.get_bone_global_rest(skeleton.find_bone("LeftFoot")).origin
	return hip.distance_to(knee) + knee.distance_to(ankle)


# How high SOMA's hips are above its soles at rest: down the leg to the
# ankle, and the ankle's own height, which is the toe joint's drop.
func _soma_rest_hips_height() -> float:
	return -(OFFSETS[22].y + OFFSETS[23].y + OFFSETS[24].y + OFFSETS[25].y) + 0.02
