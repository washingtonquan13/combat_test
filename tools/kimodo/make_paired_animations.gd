extends SceneTree

# Generates assets/paired_animations.tres, clips made for two bodies at once,
# and for each pair of them the PairedClip that a PairedActionBeat plays.
#
#   godot --headless --path . -s res://tools/kimodo/make_paired_animations.gd
#
# Stab: one body lunges and runs a sword through the other, who is standing
# on guard, doubles over the blade, staggers back and falls dead on their
# back.
#
#   Stab_Lead      the lunge, the blade held in, the recovery
#   Stab_Partner   on guard, the hit, the fall
#
# Each half is a motion generated by Kimodo from a line of text (the takes
# and the text that made them are in tools/kimodo/takes) and carried onto
# the mannequin by soma_retarget.gd. They were generated apart; what makes
# them a pair is done here:
#
#   The same clock. Both clips are the same length, and the partner's take
#   is cut so that its body starts to give on the frame the lead's blade
#   arrives (CONTACT).
#   The same ground. The lead's clip starts over the origin and is turned so
#   the sword's tip, on the contact frame, is straight ahead (+Z). The
#   partner's clip starts over the origin facing +Z as well; where the
#   partner stands is not in the clip: it is measured here, as how far ahead
#   of the lead it must be, facing back at them, for the tip to be in its
#   chest at contact, and saved in the PairedClip that names these two.
#
# Retune by changing the numbers below and running this again.

const Retarget := preload("res://tools/kimodo/soma_retarget.gd")

const OUT := "res://assets/paired_animations.tres"
const PAIR := "res://assets/paired_clips/stab.tres"
const MODEL := "res://scenes/character_models/placeholder_model.tscn"
const TAKES := "res://tools/kimodo/takes/"

## The lead's frame on which the blade arrives.
const CONTACT := 24
## The partner's frame on which its body starts to give.
const GIVES := 38
## Frames in each clip.
const LENGTH := 66
## From the grip to the sword's tip, along the grip's +Y.
const BLADE := 0.787
## From the middle of a body to the front of its chest.
const CHEST := 0.10
## How far into the body the tip is on the contact frame. The arm goes on
## straightening after it, so the blade ends deeper than this.
const SUNK := 0.12

var _skeleton: Skeleton3D
var _player: AnimationPlayer
var _model: Node3D


func _initialize() -> void:
	_bake.call_deferred()


func _bake() -> void:
	# A frame, so the body is in the tree and knows where it is.
	await process_frame
	_model = (load(MODEL) as PackedScene).instantiate()
	root.add_child(_model)
	_skeleton = _model.find_child("GeneralSkeleton", true, false)
	_player = _model.get_node("Body/AnimationPlayer")
	var grip_fingers: Animation = _player.get_animation(&"Weapon/Stance_Sword")

	var lunge := Retarget.new()
	var fall := Retarget.new()
	if not lunge.read(TAKES + "lunge") or not fall.read(TAKES + "guard_fall"):
		push_error("takes missing")
		quit(1)
		return

	# The lead is built twice: once facing any way, to find where its tip is
	# at contact, then turned so that is straight ahead.
	var placed: Transform3D = lunge.squared()
	var tip: Vector3 = _tip(_armed(lunge.animation(_skeleton, 0, LENGTH - 1, placed, grip_fingers)), CONTACT / Retarget.FPS)
	placed = Transform3D(Basis(Vector3.UP, -atan2(tip.x, tip.z)), Vector3.ZERO) * placed
	var lead: Animation = _armed(lunge.animation(_skeleton, 0, LENGTH - 1, placed, grip_fingers))
	tip = _tip(lead, CONTACT / Retarget.FPS)

	var from: int = GIVES - CONTACT
	var partner: Animation = fall.animation(_skeleton, from, from + LENGTH - 1, fall.squared(from))

	var library := AnimationLibrary.new()
	library.add_animation(&"Stab_Lead", lead)
	library.add_animation(&"Stab_Partner", partner)
	var err: Error = ResourceSaver.save(library, OUT)
	print("%s: %s" % [OUT, error_string(err)])
	print("contact at %.3f s, length %.3f s" % [CONTACT / Retarget.FPS, lead.length])
	var ahead: float = tip.z + CHEST - SUNK
	print("tip at contact %s; partner stands %.3f m ahead, facing back" % [tip, ahead])

	var pair := PairedClip.new()
	pair.lead_clip = "Paired/Stab_Lead"
	pair.partner_clip = "Paired/Stab_Partner"
	pair.partner_from_lead = Transform3D(Basis(Vector3.UP, PI), Vector3(0.0, 0.0, ahead))
	pair.contact_time = CONTACT / Retarget.FPS
	pair.length = lead.length
	pair.kills_partner = true
	DirAccess.make_dir_recursive_absolute(PAIR.get_base_dir())
	var pair_err: Error = ResourceSaver.save(pair, PAIR)
	print("%s: %s" % [PAIR, error_string(pair_err)])
	quit(0 if err == OK and pair_err == OK else 1)


# The clip with the right wrist turned so a sword in that hand lies along
# the forearm. Kimodo's body holds nothing, and leaves the wrist wherever
# an empty hand would be; a lunge wants the blade in line with the arm.
func _armed(clip: Animation) -> Animation:
	var hand: int = _skeleton.find_bone("RightHand")
	var forearm: int = _skeleton.find_bone("RightLowerArm")
	var track: int = clip.find_track(NodePath("%GeneralSkeleton:RightHand"), Animation.TYPE_ROTATION_3D)
	var grip: Node3D = _model.get("main_hand_grip")
	_show(clip)
	for key in clip.track_get_key_count(track):
		_player.seek(clip.track_get_key_time(track, key), true)
		_player.advance(0.0)
		var arm: Transform3D = _skeleton.get_bone_global_pose(forearm)
		var wrist: Transform3D = _skeleton.get_bone_global_pose(hand)
		var along: Vector3 = (wrist.origin - arm.origin).normalized()
		var blade: Vector3 = (wrist.basis * grip.transform.basis.y).normalized()
		var turned: Basis = Basis(Quaternion(blade, along)) * wrist.basis
		clip.track_set_key_value(track, key, (arm.basis.inverse() * turned).get_rotation_quaternion())
	_hide()
	return clip


# Where the tip of a sword in the right hand is, in the body's own space, at
# a time in a clip.
func _tip(clip: Animation, time: float) -> Vector3:
	_show(clip)
	_player.seek(time, true)
	_player.advance(0.0)
	var grip: Node3D = _model.get("main_hand_grip")
	var hand: Transform3D = _skeleton.get_bone_global_pose(_skeleton.find_bone("RightHand"))
	var tip: Vector3 = _skeleton.global_transform * hand * grip.transform * Vector3(0.0, BLADE, 0.0)
	_hide()
	return _model.global_transform.affine_inverse() * tip


func _show(clip: Animation) -> void:
	var library := AnimationLibrary.new()
	library.add_animation(&"probe", clip)
	_player.add_animation_library(&"_probe", library)
	_player.play(&"_probe/probe")


func _hide() -> void:
	_player.stop()
	_player.remove_animation_library(&"_probe")
