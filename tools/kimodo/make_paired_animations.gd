extends SceneTree

# Generates assets/paired_animations.tres, clips made for two bodies at once,
# and for each pair of them the PairedClip that a PairedActionBeat plays.
#
#   godot --headless --path . -s res://tools/kimodo/make_paired_animations.gd
#
# Stab: one body lunges and runs a sword through the other, who is standing
# on guard, doubles over the blade, staggers back and falls dead on their
# back.
#
#   Stab_Lead      the lunge, the blade held in, the recovery
#   Stab_Partner   on guard, the hit, the fall
#
# Chop: one body raises a weapon in both hands and brings it down on the
# shoulder of the other, who is standing on guard, drops to their knees and
# falls dead on their face.
#
#   Chop_Lead      the raise, the chop, the step back
#   Chop_Partner   on guard, the blow, the knees, the face
#
# Each half is a motion generated by Kimodo from a line of text (the takes
# and the text that made them are in tools/kimodo/takes) and carried onto
# the mannequin by soma_retarget.gd. They were generated apart; what makes
# them a pair is done here:
#
#   The same clock. Both clips are the same length, and the partner's take
#   is cut so that its body starts to give on the frame the lead's blade
#   arrives (contact). A lead take shorter than that holds its last frame.
#   The same ground. The lead's clip starts over the origin and is turned so
#   the sword's tip, on the contact frame, is straight ahead (+Z). The
#   partner's clip starts over the origin facing +Z as well; where the
#   partner stands is not in the clip: it is measured here, as how far ahead
#   of the lead it must be, facing back at them, for the tip to be in its
#   chest at contact, and saved in the PairedClip that names these two.
#
# Retune by changing the numbers below and running this again.

const Retarget := preload("res://tools/kimodo/soma_retarget.gd")

const OUT := "res://assets/paired_animations.tres"
const PAIRS := "res://assets/paired_clips/"
const MODEL := "res://scenes/character_models/placeholder_model.tscn"
const TAKES := "res://tools/kimodo/takes/"

## From the grip to the sword's tip, along the grip's +Y.
const BLADE := 0.787
## From the grip to where a chopping weapon's head lands, along the grip's +Y.
const HEAD := 0.6
## From the middle of a body to the front of its chest.
const CHEST := 0.10
## How far into the body the stab's tip is on the contact frame. The arm
## goes on straightening after it, so the blade ends deeper than this.
const SUNK := 0.12
## How far ahead of the middle of the struck body the chop's head lands: on
## top of the shoulder, which is over the middle.
const SHOULDER := 0.05

## Each pair. contact: the lead's frame on which the weapon arrives. gives:
## the partner's frame on which its body starts to give. length: frames in
## each clip. reach: grip to the point that lands. armed: the wrist is
## turned to put the blade along the forearm (a thrust; a chop's wrist is
## Kimodo's own). into: how far ahead of the partner's middle that point is
## at contact.
##
## The chop's head comes down through shoulder height on frame 47. The
## struck take gives at about 45 and cannot start before its own first
## frame, so its knees go two frames before the blow lands.
const SPECS := [
	{name = "Stab", lead = "lunge", partner = "guard_fall", contact = 24, gives = 38,
		length = 66, reach = BLADE, armed = true, into = CHEST - SUNK},
	{name = "Chop", lead = "chop", partner = "guard_struck", contact = 47, gives = 47,
		length = 110, reach = HEAD, armed = false, into = -SHOULDER},
]

var _skeleton: Skeleton3D
var _player: AnimationPlayer
var _model: Node3D


func _initialize() -> void:
	_bake.call_deferred()


func _bake() -> void:
	# A frame, so the body is in the tree and knows where it is.
	await process_frame
	_model = (load(MODEL) as PackedScene).instantiate()
	root.add_child(_model)
	_skeleton = _model.find_child("GeneralSkeleton", true, false)
	_player = _model.get_node("Body/AnimationPlayer")
	var grip_fingers: Animation = _player.get_animation(&"Weapon/Stance_Sword")

	var library := AnimationLibrary.new()
	var ok := true
	for spec: Dictionary in SPECS:
		ok = _pair(spec, library, grip_fingers) and ok
	var err: Error = ResourceSaver.save(library, OUT)
	print("%s: %s" % [OUT, error_string(err)])
	quit(0 if ok and err == OK else 1)


# Adds one pair's two clips to `library` and saves its PairedClip.
func _pair(spec: Dictionary, library: AnimationLibrary, grip_fingers: Animation) -> bool:
	var leading := Retarget.new()
	var following := Retarget.new()
	if not leading.read(TAKES + spec.lead) or not following.read(TAKES + spec.partner):
		push_error("takes missing for %s" % spec.name)
		return false
	var contact: float = spec.contact / Retarget.FPS
	var last: int = mini(spec.length, leading.frames) - 1

	# The lead is built twice: once facing any way, to find where its weapon
	# lands at contact, then turned so that is straight ahead.
	var placed: Transform3D = leading.squared()
	var tip: Vector3 = _tip(_lead(leading, last, placed, grip_fingers, spec), contact, spec.reach)
	placed = Transform3D(Basis(Vector3.UP, -atan2(tip.x, tip.z)), Vector3.ZERO) * placed
	var lead: Animation = _lead(leading, last, placed, grip_fingers, spec)
	tip = _tip(lead, contact, spec.reach)
	lead.length = (spec.length - 1) / Retarget.FPS

	var from: int = spec.gives - spec.contact
	var partner: Animation = following.animation(_skeleton, from, from + spec.length - 1, following.squared(from))

	library.add_animation(StringName(spec.name + "_Lead"), lead)
	library.add_animation(StringName(spec.name + "_Partner"), partner)
	var ahead: float = tip.z + spec.into
	print("%s: contact at %.3f s, length %.3f s; lands at %s; partner stands %.3f m ahead, facing back"
			% [spec.name, contact, lead.length, tip, ahead])

	var pair := PairedClip.new()
	pair.lead_clip = "Paired/%s_Lead" % spec.name
	pair.partner_clip = "Paired/%s_Partner" % spec.name
	pair.partner_from_lead = Transform3D(Basis(Vector3.UP, PI), Vector3(0.0, 0.0, ahead))
	pair.contact_time = contact
	pair.length = lead.length
	pair.kills_partner = true
	DirAccess.make_dir_recursive_absolute(PAIRS)
	var path: String = PAIRS + String(spec.name).to_lower() + ".tres"
	var err: Error = ResourceSaver.save(pair, path)
	print("%s: %s" % [path, error_string(err)])
	return err == OK


func _lead(take: Retarget, last: int, placed: Transform3D, grip_fingers: Animation, spec: Dictionary) -> Animation:
	var clip: Animation = take.animation(_skeleton, 0, last, placed, grip_fingers)
	return _armed(clip) if spec.armed else clip


# The clip with the right wrist turned so a sword in that hand lies along
# the forearm. Kimodo's body holds nothing, and leaves the wrist wherever
# an empty hand would be; a lunge wants the blade in line with the arm.
func _armed(clip: Animation) -> Animation:
	var hand: int = _skeleton.find_bone("RightHand")
	var forearm: int = _skeleton.find_bone("RightLowerArm")
	var track: int = clip.find_track(NodePath("%GeneralSkeleton:RightHand"), Animation.TYPE_ROTATION_3D)
	var grip: Node3D = _model.get("main_hand_grip")
	_show(clip)
	for key in clip.track_get_key_count(track):
		_player.seek(clip.track_get_key_time(track, key), true)
		_player.advance(0.0)
		var arm: Transform3D = _skeleton.get_bone_global_pose(forearm)
		var wrist: Transform3D = _skeleton.get_bone_global_pose(hand)
		var along: Vector3 = (wrist.origin - arm.origin).normalized()
		var blade: Vector3 = (wrist.basis * grip.transform.basis.y).normalized()
		var turned: Basis = Basis(Quaternion(blade, along)) * wrist.basis
		clip.track_set_key_value(track, key, (arm.basis.inverse() * turned).get_rotation_quaternion())
	_hide()
	return clip


# Where the point `reach` up a weapon in the right hand is, in the body's own space, at
# a time in a clip.
func _tip(clip: Animation, time: float, reach: float) -> Vector3:
	_show(clip)
	_player.seek(time, true)
	_player.advance(0.0)
	var grip: Node3D = _model.get("main_hand_grip")
	var hand: Transform3D = _skeleton.get_bone_global_pose(_skeleton.find_bone("RightHand"))
	var tip: Vector3 = _skeleton.global_transform * hand * grip.transform * Vector3(0.0, reach, 0.0)
	_hide()
	return _model.global_transform.affine_inverse() * tip


func _show(clip: Animation) -> void:
	var library := AnimationLibrary.new()
	library.add_animation(&"probe", clip)
	_player.add_animation_library(&"_probe", library)
	_player.play(&"_probe/probe")


func _hide() -> void:
	_player.stop()
	_player.remove_animation_library(&"_probe")
