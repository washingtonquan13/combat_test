extends SceneTree

# Generates assets/scene_animations.tres, clips a cinematic plays on one body
# that no gameplay stance has: mounted on the mannequin as "Scene".
#
#   godot --headless --path . -s res://tools/kimodo/make_scene_animations.gd
#
#   Shout      on guard, then an arm thrown out ahead, pointing, held
#   Cower      looking about, then stooped with both arms over the head, held
#   Fall_Wall  standing, an arrow in the chest, a stagger back and off a
#              rampart's edge: down the wall's height, onto the back
#
# Each is a motion generated by Kimodo from a line of text (the takes and the
# text that made them are in tools/kimodo/takes) and carried onto the
# mannequin by soma_retarget.gd, starting over the origin facing +Z.
#
# None loops. A stand-in shows a clip that ends on its last frame, so a body
# that cowers stays cowering and one that fell stays down.
#
# THE DROP. Kimodo's ground is level, and the take falls onto it. Off a wall
# the body has further to go: from DROP_FROM the hips are lowered as well,
# accelerating as a fall does, until they are WALL lower on DROP_TO. The
# body's own collapse goes on over it, so it lands on its back at the foot.
# The unit itself stays where it stood; the clip moves only its body.

const Retarget := preload("res://tools/kimodo/soma_retarget.gd")

const OUT := "res://assets/scene_animations.tres"
const MODEL := "res://scenes/character_models/placeholder_model.tscn"
const TAKES := "res://tools/kimodo/takes/"

## The raid camp's rampart walk above the ground, in metres.
const WALL := 2.25
## The arrow-fall take's frames between which the body drops the wall's
## height: from the hips leaving the walk's edge to about a free fall later.
const DROP_FROM := 44
const DROP_TO := 64

## [clip, take, first frame, last frame (-1 = the take's last)].
const CLIPS := [
	["Shout", "shout", 0, -1],
	["Cower", "cower", 0, -1],
	["Fall_Wall", "arrow_fall", 0, -1],
]


func _initialize() -> void:
	_bake.call_deferred()


func _bake() -> void:
	await process_frame
	var model: Node3D = (load(MODEL) as PackedScene).instantiate()
	root.add_child(model)
	var skeleton: Skeleton3D = model.find_child("GeneralSkeleton", true, false)
	var library := AnimationLibrary.new()
	for entry: Array in CLIPS:
		var take := Retarget.new()
		if not take.read(TAKES + entry[1]):
			push_error("take missing: %s" % entry[1])
			quit(1)
			return
		var clip: Animation = take.animation(skeleton, entry[2], entry[3], take.squared(entry[2]))
		if entry[0] == "Fall_Wall":
			# The track is in the skeleton's space, which the model may scale.
			_drop(clip, WALL / skeleton.global_transform.basis.get_scale().y)
		library.add_animation(StringName(entry[0]), clip)
		print("%s: %.2f s" % [entry[0], clip.length])
	var err: Error = ResourceSaver.save(library, OUT)
	print("%s: %s" % [OUT, error_string(err)])
	quit(0 if err == OK else 1)


# Lowers the hips by `depth` from DROP_FROM to DROP_TO, as t squared, and
# holds them that much lower after.
func _drop(clip: Animation, depth: float) -> void:
	var track: int = clip.find_track(NodePath("%GeneralSkeleton:Hips"), Animation.TYPE_POSITION_3D)
	for key in clip.track_get_key_count(track):
		var frame: float = clip.track_get_key_time(track, key) * Retarget.FPS
		var part: float = clampf((frame - DROP_FROM) / (DROP_TO - DROP_FROM), 0.0, 1.0)
		var at: Vector3 = clip.track_get_key_value(track, key)
		clip.track_set_key_value(track, key, at - Vector3(0.0, depth * part * part, 0.0))
